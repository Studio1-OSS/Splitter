# ── Required for receipt scanning ────────────────────────────────────────────
# Create a key at https://tokenfactory.nebius.com (new accounts get trial credit).
NEBIUS_API_KEY=
# Optional overrides
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3.5-Super-VL
# How reasoning is toggled: chat_template_kwargs (enable_thinking) or none
AI_REASONING_PARAM=chat_template_kwargs
# Daily AI credits. Reading a bill, a payment screenshot or a question = 1; a "Settle with AI" plan = 3.
AI_CREDITS_PER_USER_PER_DAY=30

# ── Database ─────────────────────────────────────────────────────────────────
# Local SQLite file by default. For production use Turso: libsql://<db>-<org>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Notifications (required) ─────────────────────────────────────────────────
# Free Novu account: https://novu.co. See README → "Notifications".
NOVU_SECRET_KEY=
NOVU_APP_ID=
NOVU_WORKFLOW_ID=splitter-activity
